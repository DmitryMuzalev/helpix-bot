{
  "name": "helpix-bot",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:articles": "deno test --allow-env --config supabase/functions/articles/deno.json supabase/functions/_shared/adapters/article-handler.test.ts supabase/functions/_shared/adapters/article-repository.test.ts",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "web:dev": "npm --prefix apps/web run dev",
    "web:build": "npm --prefix apps/web run build",
    "web:typecheck": "npm --prefix apps/web run typecheck",
    "web:test": "npm --prefix apps/web run test:e2e",
    "typecheck": "deno check --config supabase/functions/clients/deno.json supabase/functions/clients/index.ts && deno check --config supabase/functions/messages/deno.json supabase/functions/messages/index.ts && deno check --config supabase/functions/telegram-webhook/deno.json supabase/functions/telegram-webhook/index.ts && deno check --config supabase/functions/articles/deno.json supabase/functions/articles/index.ts",
    "db:migrate": "supabase db push --linked --skip-vault",
    "functions:deploy": "supabase functions deploy",
    "webhook:set": "node --env-file=.env scripts/register-telegram-webhook.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.8",
    "supabase": "^2.117.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
